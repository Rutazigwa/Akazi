# Copy to deploy/.env. Never commit it.

SITE_ADDRESS=akazi.example.rw

POSTGRES_USER=akazi
POSTGRES_PASSWORD=            # generate: openssl rand -base64 32
POSTGRES_DB=akazi

# REQUIRED. The app will not start without it.
#   rwanda_self_hosted | split_store | cross_border_authorised | local_dev
DATA_RESIDENCY=rwanda_self_hosted

# Only when DATA_RESIDENCY=cross_border_authorised
NCSA_CERTIFICATE_REF=

# Identity data requires a second factor on the session. Leave this on.
REQUIRE_MFA_FOR_IDENTITY=true
