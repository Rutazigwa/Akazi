# Copy to deploy/.env. Never commit it.

SITE_ADDRESS=akazi.example.rw

POSTGRES_USER=akazi
POSTGRES_PASSWORD=            # generate: openssl rand -base64 32
POSTGRES_DB=akazi

# The application's own role -- NOT the owner above. Created by
# scripts/create_app_role.sql. generate: openssl rand -base64 32
APP_DB_PASSWORD=

# REQUIRED. The app will not start without it.
#   rwanda_self_hosted | split_store | cross_border_authorised | local_dev
DATA_RESIDENCY=rwanda_self_hosted

# Only when DATA_RESIDENCY=cross_border_authorised
NCSA_CERTIFICATE_REF=

# Identity data requires a second factor on the session. Setting this to false
# is refused at startup outside local_dev, so this line documents the rule
# rather than offering a choice -- a password alone would otherwise reach
# national ID numbers.
REQUIRE_MFA_FOR_IDENTITY=true

# Shared secret for the messaging provider's inbound webhook. Unset means the
# endpoint returns 503 rather than accepting unauthenticated posts.
INBOUND_WEBHOOK_SECRET=
