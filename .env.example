# Copy to .env and fill in. Never commit .env.

# Data residency posture. REQUIRED -- the app refuses to start without it.
#   rwanda_self_hosted       Postgres on a Rwandan/regional VPS (pilot default)
#   split_store              Identity data in Rwanda, opaque UUIDs abroad
#   cross_border_authorised  NCSA certificate held (set NCSA_CERTIFICATE_REF)
#   local_dev                Throwaway data on a local database only
DATA_RESIDENCY=local_dev

DATABASE_URL=postgresql+psycopg://placement:placement@localhost:5432/placement_ops

# Only when DATA_RESIDENCY=cross_border_authorised
# NCSA_CERTIFICATE_REF=

DEBUG=false
